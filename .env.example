# Copy to .env.local and supply your own server-side credential.
# Leave blank for frontend-only work with built-in commentary fallback.
GROQ_API_KEY=

# Separate, incomplete leaderboard integration only.
# Its Redis dependency is absent from the supplied package manifest.
# Setting these values alone does not make the endpoint deployment-ready.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
